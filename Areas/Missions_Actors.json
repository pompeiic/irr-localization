					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"zh-Hans": {
					"text": "解锁枪械与配件的<strong>材料修理</>。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ru": {
					"text": "Открывает <strong>ремонт за материалы</> для оружия и модулей.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ko": {
					"text": "총기 및 부착물 <strong>재료 수리</>를 해금합니다.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ja": {
					"text": "銃およびアタッチメントの<strong>素材修理</>をアンロックします。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"es-ES": {
					"text": "Desbloquea las <strong>reparaciones con materiales</> para armas y accesorios.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				}
			}
		},
		{
			"ns": "",
			"key": "533B1ECA4A7D56DE10A485AC968F5D52",
			"source": "<strong>Replaces</> the basic lighting with more advanced <strong>fluorescent</> lighting.",
			"sourceHash": "4317f500",
			"origin": "/Game/Blueprints/MissionSystem/Actors/Hideout/BP_HideoutUnit_Lighting.BP_HideoutUnit_Lighting_C:BP_IRRHideoutUnitComponent_GEN_VARIABLE.UpgradeLevels(1).UpgradeLevels.UpgradeLevelDescription",
			"t": {
				"de": {
					"text": "<strong>Ersetzt</> die einfache Beleuchtung durch fortschrittlichere <strong>Leuchtstofflampen</>.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"zh-Hans": {
					"text": "将基础照明<strong>替换</>为更高级的<strong>荧光灯</>照明。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ru": {
					"text": "<strong>Заменяет</> базовое освещение на более продвинутое <strong>люминесцентное</>.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ko": {
					"text": "기본 조명을 더 발전된 <strong>형광등</> 조명으로 <strong>교체</>합니다.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ja": {
					"text": "基本照明を、より高度な<strong>蛍光灯</>照明に<strong>交換</>します。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"es-ES": {
					"text": "<strong>Sustituye</> la iluminación básica por una más avanzada iluminación <strong>fluorescente</>.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				}
			}
		},
