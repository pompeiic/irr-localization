		{
			"ns": "",
			"key": "5D6852944B18261FE2433C937EF27129",
			"source": "Builds a <strong>satelliate antenna</> that provides additional <strong>information</> from each faction at your deploy screen. ",
			"sourceHash": "1be0869b",
			"origin": "/Game/Blueprints/MissionSystem/Actors/Hideout/BP_HideoutUnit_IntelCenter.BP_HideoutUnit_IntelCenter_C:BP_IRRHideoutUnitComponent_GEN_VARIABLE.UpgradeLevels(2).UpgradeLevels.UpgradeLevelDescription",
			"t": {
				"de": {
					"text": "Baut eine <strong>Satellitenantenne</>, die auf deinem Einsatzbildschirm zusätzliche <strong>Informationen</> der einzelnen Fraktionen anzeigt. ",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"zh-Hans": {
					"text": "建造一座<strong>卫星天线</>，在你的部署界面上提供来自各派系的额外<strong>情报</>。 ",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ru": {
					"text": "Строит <strong>спутниковую антенну</>, передающую дополнительные <strong>сведения</> от каждой фракции на экране высадки. ",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ko": {
					"text": "출격 화면에서 각 파벌의 추가 <strong>정보</>를 제공하는 <strong>위성 안테나</>를 건설합니다. ",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ja": {
					"text": "出撃画面で各派閥からの追加<strong>情報</>を提供する<strong>衛星アンテナ</>を建設します。 ",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"es-ES": {
					"text": "Construye una <strong>antena satelital</> que proporciona <strong>información</> adicional de cada facción en la pantalla de despliegue. ",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				}
			}
		},
		{
			"ns": "",
			"key": "6D8A303D47EC414C49404094226EB86D",
			"source": "Adds more <strong>targets</> that are <strong>lit</> to help visibility during night times.",
			"sourceHash": "d54f6e59",
			"origin": "/Game/Blueprints/MissionSystem/Actors/Hideout/BP_HideoutUnit_Master_ShootingRange.BP_HideoutUnit_Master_ShootingRange_C:BP_IRRHideoutUnitComponent_GEN_VARIABLE.UpgradeLevels(1).UpgradeLevels.UpgradeLevelDescription",
			"t": {
				"de": {
					"text": "Fügt weitere <strong>Ziele</> hinzu, die <strong>beleuchtet</> sind, um die Sichtbarkeit bei Nacht zu verbessern.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"zh-Hans": {
					"text": "增加更多带有<strong>照明</>的<strong>靶标</>，以便在夜间看清。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ru": {
					"text": "Добавляет больше <strong>мишеней</>, которые <strong>подсвечены</> для лучшей видимости ночью.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ko": {
					"text": "야간 시야를 돕기 위해 <strong>조명이 켜진</> <strong>표적</>을 더 추가합니다.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ja": {
					"text": "夜間の視認性を高めるため、<strong>照明付き</>の<strong>ターゲット</>を追加します。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"es-ES": {
					"text": "Añade más <strong>dianas</> que están <strong>iluminadas</> para facilitar la visibilidad de noche.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				}
			}
		},
