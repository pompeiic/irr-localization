		{
			"ns": "",
			"key": "0C0926214FC3DEDE03E9B686D4D7815D",
			"source": "<strong>Cleans</> up the <strong>rocks</>, adds <strong>fresh concrete flooring</>, as well as <strong>seal</> the gaps in the roof and <strong>repaints</> the wall bricks.",
			"sourceHash": "94cc3025",
			"origin": "/Game/Blueprints/MissionSystem/Actors/Hideout/BP_HideoutUnit_Structure.BP_HideoutUnit_Structure_C:BP_IRRHideoutUnitComponent_GEN_VARIABLE.UpgradeLevels(1).UpgradeLevels.UpgradeLevelDescription",
			"t": {
				"de": {
					"text": "<strong>Beseitigt</> die <strong>Steine</>, verlegt einen <strong>neuen Betonboden</>, <strong>dichtet</> die Lücken im Dach ab und <strong>streicht</> das Mauerwerk neu.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"zh-Hans": {
					"text": "<strong>清理</><strong>碎石</>，铺设<strong>崭新的混凝土地面</>，并<strong>封堵</>屋顶缝隙，重新<strong>粉刷</>墙砖。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ru": {
					"text": "<strong>Убирает</> <strong>камни</>, заливает <strong>свежий бетонный пол</>, а также <strong>герметизирует</> щели в крыше и <strong>перекрашивает</> кирпичные стены.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ko": {
					"text": "<strong>돌무더기</>를 <strong>치우고</>, <strong>새 콘크리트 바닥</>을 시공하며, 지붕 틈새를 <strong>메우고</> 벽돌을 <strong>다시 칠합니다</>.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ja": {
					"text": "<strong>瓦礫</>を<strong>清掃</>し、<strong>新しいコンクリートの床</>を敷き、屋根の隙間を<strong>密閉</>して壁のレンガを<strong>塗り直します</>。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"es-ES": {
					"text": "<strong>Limpia</> los <strong>escombros</>, añade un <strong>suelo de hormigón nuevo</>, <strong>sella</> las grietas del tejado y <strong>repinta</> los ladrillos de la pared.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				}
			}
		},
		{
			"ns": "",
			"key": "0D96E12440019FD0143EF2B3ED022A7D",
			"source": "Press <Red>F</> to <Red>upgrade</> the lighting.",
			"sourceHash": "fff68b24",
			"origin": "/Game/Blueprints/MissionSystem/Actors/Hideout/BP_HideoutUnit_Lighting.BP_HideoutUnit_Lighting_C:BP_InteractionTarget_Upgrade_GEN_VARIABLE.InteractionOption_0.DefaultDisplaySetting.InteractionText",
			"t": {
				"de": {
					"text": "Drücke <Red>F</>, um die Beleuchtung <Red>aufzurüsten</>.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-25T20:56:00Z"
				},
				"zh-Hans": {
					"text": "按<Red>F</><Red>升级</>照明。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-25T20:56:00Z"
				},
				"ru": {
					"text": "Нажми <Red>F</>, чтобы <Red>улучшить</> освещение.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-25T20:56:00Z"
				},
				"ko": {
					"text": "<Red>F</> 눌러 조명 <Red>업그레이드</>",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-25T20:56:00Z"
				},
				"ja": {
					"text": "<Red>F</>で照明を<Red>強化</>",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-25T20:56:00Z"
				},
				"es-ES": {
					"text": "Pulsa <Red>F</> para <Red>mejorar</> la iluminación.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-25T20:56:00Z"
				}
			}
		},
		{
			"ns": "",
			"key": "14727CA44C1BA2D77F5826A34B12C8D8",
			"source": "Installs a <strong>large</> generator powered by <strong>diesel</> in your safehouse.",
			"sourceHash": "cf3ca614",
			"origin": "/Game/Blueprints/MissionSystem/Actors/Hideout/BP_HideoutUnit_Generator.BP_HideoutUnit_Generator_C:BP_IRRHideoutUnitComponent_GEN_VARIABLE.UpgradeLevels(0).UpgradeLevels.UpgradeLevelDescription",
			"t": {
				"de": {
					"text": "Installiert einen <strong>großen</> mit <strong>Diesel</> betriebenen Generator in deinem Versteck.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"zh-Hans": {
					"text": "在你的藏身处安装一台以<strong>柴油</>为动力的<strong>大型</>发电机。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ru": {
					"text": "Устанавливает в твоём убежище <strong>большой</> генератор, работающий на <strong>дизеле</>.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ko": {
					"text": "은신처에 <strong>디젤</>로 작동하는 <strong>대형</> 발전기를 설치합니다.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ja": {
					"text": "隠れ家に<strong>ディーゼル</>で動く<strong>大型</>発電機を設置します。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"es-ES": {
					"text": "Instala un generador <strong>grande</> alimentado por <strong>diésel</> en tu refugio.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				}
			}
		},
		{
			"ns": "",
			"key": "3BF0C5A24463D85EF871129C81FEBB16",
			"source": "Unlocks the gunsmith to <strong>customize and assemble</> all guns.",
			"sourceHash": "ceb0030a",
			"origin": "/Game/Blueprints/MissionSystem/Actors/Hideout/Gunsmith/BP_Gunsmith.BP_Gunsmith_C:BP_IRRHideoutUnitComponent_GEN_VARIABLE.UpgradeLevels(0).UpgradeLevels.UpgradeLevelDescription",
			"t": {
				"de": {
					"text": "Schaltet den Büchsenmacher frei, um alle Waffen <strong>anzupassen und zusammenzubauen</>.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"zh-Hans": {
					"text": "解锁改枪功能，可<strong>改装与组装</>所有枪械。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ru": {
					"text": "Открывает оружейника, позволяя <strong>модифицировать и собирать</> любое оружие.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ko": {
					"text": "모든 총기를 <strong>개조 및 조립</>할 수 있는 총기 개조를 해금합니다.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ja": {
					"text": "すべての銃を<strong>カスタマイズおよび組み立て</>できるガンスミスをアンロックします。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"es-ES": {
					"text": "Desbloquea el armero para <strong>personalizar y montar</> todas las armas.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				}
			}
		},
		{
			"ns": "",
			"key": "424D1B4E44533B3A71C3E999AD5A37D2",
			"source": "Unlocks <strong>material repairs</> for guns & attachments.",
			"sourceHash": "ff685f9b",
			"origin": "/Game/Blueprints/MissionSystem/Actors/Hideout/Gunsmith/BP_Gunsmith.BP_Gunsmith_C:BP_IRRHideoutUnitComponent_GEN_VARIABLE.UpgradeLevels(1).UpgradeLevels.UpgradeLevelDescription",
			"t": {
				"de": {
					"text": "Schaltet <strong>Materialreparaturen</> für Waffen und Anbauteile frei.",
