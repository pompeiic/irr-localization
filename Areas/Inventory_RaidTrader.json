					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ko":
				{
					"text": "자신의 아이템이나 상인의 재고만 거래할 수 있습니다.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ja":
				{
					"text": "自分のアイテムまたは商人の在庫のみ取引できます。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"es-ES":
				{
					"text": "Solo se pueden comerciar tus propios objetos o las existencias del comerciante.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				}
			}
		},
