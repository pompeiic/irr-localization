		{
			"ns": "IRRRaidTrader",
			"key": "ForeignItem",
			"source": "Only your own items or the trader's stock can be traded.",
			"sourceHash": "4deb8370",
			"origin": "Source/Test_C/Inventory/RaidTrader/RaidTraderSession.cpp(165)",
			"t":
			{
				"de":
				{
					"text": "Nur eigene Gegenstände oder das Sortiment des Händlers können gehandelt werden.",
