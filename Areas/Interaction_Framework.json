					"by": "ai",
					"at": "2026-09-25T20:56:00Z"
				},
				"ru": {
					"text": "Нажми <Red>F</>, чтобы <Red>закрыть</> дверь.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-25T20:56:00Z"
				},
				"ko": {
					"text": "<Red>F</> 눌러 문 <Red>닫기</>",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-25T20:56:00Z"
				},
				"ja": {
					"text": "<Red>F</>でドアを<Red>閉める</>",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-25T20:56:00Z"
				},
				"es-ES": {
					"text": "Pulsa <Red>F</> para <Red>cerrar</> la puerta.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-25T20:56:00Z"
				}
			}
		},
		{
