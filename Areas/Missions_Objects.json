					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ja":
				{
					"text": "ハッキング手順を開始。任意のキーを押して中断。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"es-ES":
				{
					"text": "Iniciando procedimiento de pirateo. Pulsa cualquier tecla para interrumpir.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				}
