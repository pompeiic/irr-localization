		{
			"ns": "",
			"key": "2177300C4EACCD99F63F7EB03309EABB",
			"source": "PRESS ANY KEY TO START",
			"sourceHash": "0448b84d",
			"origin": "/Game/Blueprints/Gameloop/Menu/Widgets/WB_BeginPlayScreen.WB_BeginPlayScreen_C:WidgetTree.IRRTextBlock_8.Text",
			"t":
			{
				"de":
				{
					"text": "BELIEBIGE TASTE DRÜCKEN ZUM STARTEN",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"zh-Hans":
				{
					"text": "按任意键开始",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ru":
				{
					"text": "НАЖМИТЕ ЛЮБУЮ КЛАВИШУ ДЛЯ НАЧАЛА",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ko":
				{
					"text": "아무 키나 눌러 시작",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ja":
				{
					"text": "いずれかのキーを押してスタート",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"es-ES":
				{
					"text": "PULSA CUALQUIER TECLA PARA EMPEZAR",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				}
			}
