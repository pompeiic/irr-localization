		{
			"ns": "",
			"key": "1AB68CF34F537878467DE9B40E9E3F97",
			"source": "PERFORMANCE, CONTENT, & GRAPHICS ARE SUBJECT TO CHANGE",
			"sourceHash": "cd009a97",
			"origin": "/Game/Blueprints/Gameloop/Menu/Widgets/WB_BeginPlayScreen.WB_BeginPlayScreen_C:WidgetTree.InfoText_4.Text",
			"t":
			{
				"de":
				{
					"text": "LEISTUNG, INHALTE UND GRAFIK KÖNNEN SICH NOCH ÄNDERN",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"zh-Hans":
				{
					"text": "性能、内容和画面可能会发生变化",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ru":
				{
					"text": "ПРОИЗВОДИТЕЛЬНОСТЬ, КОНТЕНТ И ГРАФИКА МОГУТ БЫТЬ ИЗМЕНЕНЫ",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ko":
				{
					"text": "성능, 콘텐츠 및 그래픽은 변경될 수 있습니다",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ja":
				{
					"text": "パフォーマンス、コンテンツ、グラフィックは変更される場合があります",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"es-ES":
				{
					"text": "EL RENDIMIENTO, EL CONTENIDO Y LOS GRÁFICOS ESTÁN SUJETOS A CAMBIOS",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				}
			}
		},
