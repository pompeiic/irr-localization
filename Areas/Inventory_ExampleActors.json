					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ko": {
					"text": "무기 보관함을 추가로 잠금 해제하고 최대 자원을 증가시킵니다.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ja": {
					"text": "追加の武器保管庫をアンロックし、最大リソースを増加させます。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"es-ES": {
					"text": "Desbloquea espacio adicional para armas y aumenta los recursos máximos.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				}
			}
		},
