		{
			"ns": "",
			"key": "2ED48D6E430F8DED5EED2F81D3209C9D",
			"source": "Unlock additional weapon storage and increase max resources.",
			"sourceHash": "11c07695",
			"origin": "/Game/Blueprints/InventorySystem/ExampleActors/BP_InventoryStash.BP_InventoryStash_C:BP_IRRHideoutUnitComponent_GEN_VARIABLE.UpgradeLevels(2).UpgradeLevels.UpgradeLevelDescription",
			"t":
			{
				"de":
				{
					"text": "Schalte zusätzlichen Lagerplatz für Waffen frei und erhöhe die max. Ressourcen.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"zh-Hans":
				{
					"text": "解锁额外武器仓库并提高最大资源上限。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ru":
				{
					"text": "Открывает дополнительное место под оружие и увеличивает лимит ресурсов.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ko":
				{
					"text": "무기 보관함을 추가로 잠금 해제하고 최대 자원을 증가시킵니다.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"ja":
				{
					"text": "追加の武器保管庫をアンロックし、最大リソースを増加させます。",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				},
				"es-ES":
				{
					"text": "Desbloquea espacio adicional para armas y aumenta los recursos máximos.",
					"status": "machine",
					"by": "ai",
					"at": "2026-09-24T23:30:59Z"
				}
			}
		},
