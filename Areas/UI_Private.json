					"by": "ai",
					"at": "2026-10-06T23:14:59Z"
				},
				"ja":
				{
					"text": "このシステムではサポートされていない。",
					"status": "machine",
					"by": "ai",
					"at": "2026-10-06T23:14:59Z"
				},
				"es-ES":
				{
					"text": "No compatible con este sistema.",
					"status": "machine",
					"by": "ai",
					"at": "2026-10-06T23:14:59Z"
				}
			}
