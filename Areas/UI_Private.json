		{
			"ns": "IRRSettingCondition",
			"key": "Unsupported",
			"source": "Not supported on this system.",
			"sourceHash": "24334012",
			"origin": "Source/IRRCoreUI/Private/Settings/Collection/IRRSettingCondition.cpp(106)",
			"t":
			{
				"de":
				{
					"text": "Auf diesem System nicht unterstützt.",
					"status": "machine",
					"by": "ai",
					"at": "2026-10-06T23:14:59Z"
				},
				"zh-Hans":
				{
					"text": "此系统不支持。",
					"status": "machine",
					"by": "ai",
					"at": "2026-10-06T23:14:59Z"
				},
				"ru":
				{
					"text": "Не поддерживается в этой системе.",
